# Edge function secrets. Set them with `npx supabase secrets set NAME=value`
# (or Project Settings → Edge Functions → Secrets). See docs/self-hosting.md.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to functions automatically; don't set them.

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Peoplo <hr@mail.example.com>"

# Public address of the website, with https:// and no trailing slash.
# Used for links in emails; invitations only redirect to this host.
APP_URL=https://hr.example.com

# Optional: extra hosts allowed as invitation redirect targets (comma-separated,
# exact match; prefix with *. to allow subdomains).
# EXTRA_REDIRECT_HOSTS=preview.example.com,*.preview.example.com

# Required for scheduled functions; the pg_cron jobs send it as x-cron-secret.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional: web push notifications (npx web-push generate-vapid-keys).
# The public key must match VITE_VAPID_PUBLIC_KEY in the website build.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=hr@example.com
